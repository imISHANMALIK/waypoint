# Optional. Empty uses the tested, deterministic planner without a model API.
WAYPOINT_MODEL=
OPENAI_API_KEY=
# Set a project-relative or absolute directory for SQLite state.
WAYPOINT_DATA_DIR=./data
# Hosted single-operator access. Use a random secret of at least 24 characters.
WAYPOINT_ACCESS_TOKEN=
WAYPOINT_REQUIRE_AUTH=0
WAYPOINT_EPHEMERAL=0
